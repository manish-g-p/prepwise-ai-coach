# Copy to .env and fill in your own values. Never commit the real .env.

# ── MongoDB Atlas (free M0) ────────────────────────────────────────────────
# Atlas → Connect → Drivers. Replace <password> with your DB user's password.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/interview-ai?appName=Cluster0

# ── Google Gemini (Google AI Studio - free tier) ───────────────────────────
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=your-gemini-api-key

# ── Auth ───────────────────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-long-random-secret

# ── Optional ───────────────────────────────────────────────────────────────
# Port to listen on. Hosting platforms (Render) inject this automatically.
# PORT=3000

# Comma-separated list of allowed browser origins (CORS).
# Set this to your deployed frontend URL in production.
# FRONTEND_URL=http://localhost:5173

# Set to "production" when deployed. This switches the auth cookie to
# SameSite=None; Secure, which is required when the frontend and API are on
# different domains. Leave unset locally.
# NODE_ENV=production

# Override the Gemini models if the defaults hit quota limits.
# Free-tier friendly options: gemini-flash-lite-latest, gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
